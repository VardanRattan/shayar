#!/usr/bin/env bash
set -euo pipefail

# Default variables
CACHE_FOLDER="$HOME/.cache/shayar/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
[ -f "$HOME/.config/shayar/settings/shayar.conf" ] && source "$HOME/.config/shayar/settings/shayar.conf"
DEFAULT_WALLPAPER="${WALLPAPER_FOLDER:-$HOME/.config/shayar/wallpapers}/default.png"
AWWW_DAEMON_VERSION="$(awww-daemon --version 2>/dev/null | awk '{ print $2 }')"
AWWW_CACHE_FOLDER="${XDG_CACHE_HOME:-"$HOME/.cache"}/awww/$AWWW_DAEMON_VERSION"

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# --- UI Functions (Redirected to stderr) ---
info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Ensure that cache folder exists
mkdir -p "$HOME/.cache"


# Set Wallpaper
mkdir -p "$CACHE_FOLDER"
if [ ! -f "$CACHE_FILE" ]; then
    touch "$CACHE_FILE"
    if [ -f "$DEFAULT_WALLPAPER" ]; then
        echo "$DEFAULT_WALLPAPER" > "$CACHE_FILE"
        info "Cache file created with default wallpaper"
    else
        # Find any fallback wallpaper in the folder
        fallback_wallpaper=$(find "$HOME/.config/shayar/wallpapers" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" \) | head -n 1)
        if [ -n "$fallback_wallpaper" ]; then
            echo "$fallback_wallpaper" > "$CACHE_FILE"
            warn "Default wallpaper not found. Found fallback: $fallback_wallpaper"
        else
            error "No wallpapers found in ~/.config/shayar/wallpapers/. Wallpaper cache initialized empty."
        fi
    fi
fi

[ -f "$HOME/.config/shayar/library.sh" ] && source "$HOME/.config/shayar/library.sh" || true

# Apply wallpaper theming on startup only if needed.
# Skips heavy matugen & imagemagick regeneration if colors & blur are already cached.
CURRENT_WP=$(cat "$CACHE_FILE" 2>/dev/null || true)
if [ -n "$CURRENT_WP" ] && [ -f "$CURRENT_WP" ]; then
    CURRENT_WP="$(realpath "$CURRENT_WP")"
elif [ -n "$CURRENT_WP" ] && [ -f "${WALLPAPER_FOLDER:-$HOME/.config/shayar/wallpapers}/$CURRENT_WP" ]; then
    CURRENT_WP="$(realpath "${WALLPAPER_FOLDER:-$HOME/.config/shayar/wallpapers}/$CURRENT_WP")"
elif [ -f "$DEFAULT_WALLPAPER" ]; then
    CURRENT_WP="$(realpath "$DEFAULT_WALLPAPER")"
else
    fallback_wallpaper=$(find "$HOME/.config/shayar/wallpapers" -type f \( -name "*.png" -o -name "*.jpg" -o -name "*.jpeg" -o -name "*.webp" \) 2>/dev/null | head -n 1)
    CURRENT_WP="${fallback_wallpaper:-$DEFAULT_WALLPAPER}"
fi

# Ensure cache and Caelestia wallpaper path are always valid absolute paths
echo "$CURRENT_WP" > "$CACHE_FILE"
CAELESTIA_WALL_DIR="${HOME}/.local/state/caelestia/wallpaper"
mkdir -p "$CAELESTIA_WALL_DIR"
echo "$CURRENT_WP" > "$CAELESTIA_WALL_DIR/path.txt"

SCHEME_FILE="${HOME}/.local/state/caelestia/scheme.json"
BLUR_FILE="${CACHE_FOLDER}/blurred_wallpaper.png"

if [[ -z $(find "$AWWW_CACHE_FOLDER" -mindepth 1 -maxdepth 1 -type f 2>/dev/null | head -n 1) ]]; then
    info "Cold start: applying wallpaper and theming for $CURRENT_WP"
    ~/.config/shayar/scripts/shayar-wallpaper "$CURRENT_WP" &
elif [ ! -f "$SCHEME_FILE" ] || [ ! -f "$BLUR_FILE" ]; then
    info "Missing color or blur cache, generating theming for $CURRENT_WP"
    ~/.config/shayar/scripts/shayar-wallpaper "$CURRENT_WP" --skip-wallpaper &
else
    info "Wallpaper and theming already cached; skipping redundant reprocessing"
fi

run_extensions "autostart"
