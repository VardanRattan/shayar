# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------
POSH=agnoster

# -----------------------------------------------------
# oh-myzsh themes: https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# -----------------------------------------------------
# ZSH_THEME=robbyrussell

# -----------------------------------------------------
# oh-my-zsh plugins
# -----------------------------------------------------
plugins=(
    git
    sudo
    web-search
    archlinux
    zsh-autosuggestions
    zsh-syntax-highlighting
    copyfile
    copybuffer
    dirhistory
)

# Set-up oh-my-zsh
source $ZSH/oh-my-zsh.sh

# -----------------------------------------------------
# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# -----------------------------------------------------
if command -v fzf >/dev/null 2>&1; then
    _FZF_ZSH_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/shayar/fzf.zsh"
    if [ ! -f "$_FZF_ZSH_CACHE" ]; then
        mkdir -p "$(dirname "$_FZF_ZSH_CACHE")"
        fzf --zsh > "$_FZF_ZSH_CACHE" 2>/dev/null || true
    fi
    [ -f "$_FZF_ZSH_CACHE" ] && source "$_FZF_ZSH_CACHE"
fi

# zsh history
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
