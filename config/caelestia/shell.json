{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "background": {
        "enabled": false
    },
    "bar": {
        "persistent": true
    },
    "dashboard": {
        "enabled": true,
        "mediaUpdateInterval": 2000,
        "resourceUpdateInterval": 5000,
        "showWeather": true
    },
    "general": {
        "apps": {
            "terminal": [
                "kitty"
            ]
        },
        "battery": {
            "criticalLevel": 0
        },
        "idle": {
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": false,
            "timeouts": [
            ]
        },
        "logo": "~/.config/shayar/assets/shayar.svg"
    },
    "nexus": {
        "networkRescanInterval": 60000
    },
    "paths": {
        "wallpaperDir": "~/.config/shayar/wallpapers"
    },
    "services": {
        "gpuType": "Auto",
        "smartScheme": false
    },
    "session": {
        "commands": {
            "hibernate": [
                "shayar-power",
                "-h"
            ],
            "logout": [
                "shayar-power",
                "-e"
            ],
            "reboot": [
                "shayar-power",
                "-r"
            ],
            "shutdown": [
                "shayar-power",
                "-p"
            ]
        },
        "enabled": true
    },
    "utilities": {
        "enabled": true,
        "vpn": {
            "enabled": false
        }
    }
}
