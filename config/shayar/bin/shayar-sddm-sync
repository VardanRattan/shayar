#!/usr/bin/env bash
set -euo pipefail

# shayar-sddm-sync — Sync wallpaper and matugen colors to SDDM login screen
# Requires: SDDM installed, shayar SDDM theme in /usr/share/sddm/themes/shayar/
# Usage: shayar-sddm-sync [--theme-dir /path/to/theme]
THEME_DIR="/usr/share/sddm/themes/shayar"
BACKGROUNDS_DIR="$THEME_DIR/backgrounds"
SHAYAR_JSON="${HOME}/.config/shayar/themes/shayar.json"
CACHE_DIR="/var/cache/shayar/sddm"

# Source design tokens for SDDM values
source "${HOME}/.config/shayar/themes/design-tokens.env" 2>/dev/null || true

# --- Helpers ---
info()  { printf "\033[1;34m:: %s\033[0m\n" "$1"; }
warn()  { printf "\033[1;33m:: %s\033[0m\n" "$1"; }
error() { printf "\033[1;31m:: %s\033[0m\n" "$1"; }

usage() {
    cat <<EOF
shayar-sddm-sync — Sync wallpaper and colors to SDDM

Usage:
  shayar-sddm-sync              Sync current wallpaper and colors
  shayar-sddm-sync --install    Install the SDDM theme (first time)
  shayar-sddm-sync --status     Show sync status
  shayar-sddm-sync --help       Show this help

The theme must be installed first with --install. After that, run
  shayar-sddm-sync after every wallpaper change to update the login screen.
EOF
}

# --- Check SDDM ---
check_sddm() {
    if ! command -v sddm-greeter-qt6 &>/dev/null && ! command -v sddm &>/dev/null; then
        error "SDDM is not installed. Install it first:"
        echo "  sudo pacman -S sddm          # Arch"
        echo "  sudo apt install sddm        # Debian/Ubuntu"
        echo "  sudo dnf install sddm        # Fedora"
        exit 1
    fi
}

# --- Get current wallpaper ---
get_wallpaper() {
    local wp=""
    # Try awww daemon first
    if command -v awww &>/dev/null; then
        wp=$(awww query 2>/dev/null | grep -oP 'image: \K.*' || true)
    fi
    # Fallback: check cached wallpaper
    if [ -z "$wp" ] && [ -f "${HOME}/.cache/shayar/current_wallpaper" ]; then
        wp=$(cat "${HOME}/.cache/shayar/current_wallpaper")
    fi
    # Fallback: check design-tokens
    if [ -z "$wp" ] && [ -f "$HOME/.config/shayar/wallpapers/default.png" ]; then
        wp="$HOME/.config/shayar/wallpapers/default.png"
    fi
    if [ -z "$wp" ] || [ ! -f "$wp" ]; then
        error "No wallpaper found. Set one with: shayar-wallpaper <path>"
        exit 1
    fi
    echo "$wp"
}

# --- Extract color from shayar.json ---
get_color() {
    local key="$1"
    jq -r ".colors.${key}.dark.color // empty" "$SHAYAR_JSON" 2>/dev/null || echo "#000000"
}

# --- Generate theme.conf.user ---
generate_theme_conf() {
    local wallpaper_file="$1"

    # Extract matugen colors
    local bg=$(get_color "background")
    local surface=$(get_color "surface")
    local surface_dim=$(get_color "surface_dim")
    local surface_container=$(get_color "surface_container")
    local surface_container_high=$(get_color "surface_container_high")
    local on_surface=$(get_color "on_surface")
    local on_surface_variant=$(get_color "on_surface_variant")
    local primary=$(get_color "primary")
    local on_primary=$(get_color "on_primary")
    local primary_container=$(get_color "primary_container")
    local error=$(get_color "error")
    local outline=$(get_color "outline")
    local outline_variant=$(get_color "outline_variant")

    cat > "$CACHE_DIR/theme.conf.user" <<EOF
[General]
background-fill-mode = "fill"
background = "${wallpaper_file}"
clock_color = "${on_surface}"
input_text_color = "${on_surface}"
input_placeholder_color = "${on_surface_variant}"
input_bg_color = "${surface_container}"
input_bg_opacity = 0.3
input_border_color = "${outline_variant}"
input_border_size = 1
button_text_color = "${on_primary}"
button_bg_color = "${primary}"
button_bg_opacity = 0.9
EOF

    chmod 644 "$CACHE_DIR/theme.conf.user"
    info "Generated theme.conf.user with matugen colors"
}

# --- Install theme ---
install_theme() {
    check_sddm

    if [ -d "$THEME_DIR" ]; then
        info "Theme already exists at $THEME_DIR"
        read -p "Reinstall? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            return 0
        fi
    fi

    info "Installing SDDM theme..."

    # Create cache directory and set permissions
    sudo mkdir -p "$CACHE_DIR"
    sudo chown -R "$USER:" "$CACHE_DIR"
    sudo chmod 755 "$CACHE_DIR"

    # Create default theme.conf.user and placeholders in cache
    local wp=$(get_wallpaper)
    cp "$wp" "$CACHE_DIR/blurred.png" 2>/dev/null || touch "$CACHE_DIR/blurred.png"
    cp "$wp" "$CACHE_DIR/avatar.png" 2>/dev/null || touch "$CACHE_DIR/avatar.png"

    cat > "$CACHE_DIR/theme.conf.user" <<EOF
[General]
background-fill-mode = "fill"
background = "blurred.png"
clock_color = "#ffffff"
input_text_color = "#ffffff"
input_placeholder_color = "#888888"
input_bg_color = "#1f1f28"
input_bg_opacity = 0.3
input_border_color = "#43474f"
input_border_size = 1
button_text_color = "#ffffff"
button_bg_color = "#acc7ff"
button_bg_opacity = 0.9
EOF
    chmod 644 "$CACHE_DIR/theme.conf.user" "$CACHE_DIR/blurred.png" "$CACHE_DIR/avatar.png"

    # Create theme structure
    sudo mkdir -p "$BACKGROUNDS_DIR"

    # Create minimal Main.qml
    sudo tee "$THEME_DIR/Main.qml" > /dev/null <<QML
import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as Controls
import SddmComponents

Item {
    id: root
    property int sessionIndex: sessionCombo.currentIndex

    Image {
        anchors.fill: parent
        source: Qt.resolvedUrl("backgrounds/blurred.png")
        fillMode: Image.PreserveAspectCrop
    }

    Rectangle {
        anchors.fill: parent
        color: "transparent"

        // Center Login Card
        Column {
            anchors.centerIn: parent
            spacing: 24

            // Avatar Container
            Rectangle {
                id: avatarContainer
                width: 120
                height: 120
                radius: 30
                color: "transparent"
                border.color: config.button_bg_color
                border.width: 2
                anchors.horizontalCenter: parent.horizontalCenter
                clip: true

                Image {
                    id: avatarImage
                    anchors.fill: parent
                    source: Qt.resolvedUrl("backgrounds/avatar.png")
                    fillMode: Image.PreserveAspectCrop
                    onStatusChanged: {
                        if (status === Image.Error) {
                            source = Qt.resolvedUrl("backgrounds/blurred.png")
                        }
                    }
                }
            }

            // Input Fields
            Column {
                spacing: 12
                anchors.horizontalCenter: parent.horizontalCenter

                Controls.TextField {
                    id: username
                    width: 280
                    height: 46
                    placeholderText: "Username"
                    text: userModel.lastUser || ""
                    color: config.input_text_color
                    placeholderTextColor: config.input_placeholder_color
                    font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                    font.pixelSize: 14
                    selectByMouse: true
                    
                    background: Rectangle {
                        radius: 12
                        color: config.input_bg_color
                        opacity: username.activeFocus ? 0.4 : config.input_bg_opacity
                        border.color: username.activeFocus ? config.button_bg_color : config.input_border_color
                        border.width: username.activeFocus ? 2 : config.input_border_size
                    }
                    onAccepted: password.forceActiveFocus()
                }

                Controls.TextField {
                    id: password
                    width: 280
                    height: 46
                    placeholderText: "Password"
                    echoMode: TextInput.Password
                    color: config.input_text_color
                    placeholderTextColor: config.input_placeholder_color
                    font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                    font.pixelSize: 14
                    selectByMouse: true
                    
                    background: Rectangle {
                        radius: 12
                        color: config.input_bg_color
                        opacity: password.activeFocus ? 0.4 : config.input_bg_opacity
                        border.color: password.activeFocus ? config.button_bg_color : config.input_border_color
                        border.width: password.activeFocus ? 2 : config.input_border_size
                    }
                    onAccepted: loginButton.clicked()
                }

                // Controls Row (ComboBox & Login Button)
                Row {
                    spacing: 10
                    anchors.horizontalCenter: parent.horizontalCenter

                    Controls.ComboBox {
                        id: sessionCombo
                        width: 170
                        height: 46
                        model: sessionModel
                        textRole: "name"
                        currentIndex: model.lastIndex

                        delegate: Controls.ItemDelegate {
                            width: sessionCombo.width
                            contentItem: Text {
                                 text: typeof name !== 'undefined' ? name : (typeof modelData !== 'undefined' && modelData ? (modelData.name || modelData) : "")
                                 color: config.input_text_color
                                 font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                                 font.pixelSize: 13
                                 elide: Text.ElideRight
                                 verticalAlignment: Text.AlignVCenter
                            }
                            background: Rectangle {
                                color: hovered ? config.input_bg_color : "transparent"
                                opacity: 0.8
                            }
                        }

                        contentItem: Text {
                            leftPadding: 12
                            rightPadding: sessionCombo.indicator ? sessionCombo.indicator.width + sessionCombo.spacing : 12
                            text: sessionCombo.displayText
                            color: config.input_text_color
                            font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                            font.pixelSize: 13
                            verticalAlignment: Text.AlignVCenter
                            elide: Text.ElideRight
                        }

                        background: Rectangle {
                            radius: 12
                            color: config.input_bg_color
                            opacity: config.input_bg_opacity
                            border.color: config.input_border_color
                            border.width: config.input_border_size
                        }
                    }

                    Controls.Button {
                        id: loginButton
                        width: 100
                        height: 46
                        text: "Login"
                        
                        contentItem: Text {
                            text: loginButton.text
                            color: config.button_text_color
                            font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                            font.pixelSize: 14
                            font.bold: true
                            horizontalAlignment: Text.AlignHCenter
                            verticalAlignment: Text.AlignVCenter
                        }

                        background: Rectangle {
                            radius: 12
                            color: config.button_bg_color
                            opacity: loginButton.hovered ? 1.0 : config.button_bg_opacity
                        }
                        onClicked: sddm.login(username.text, password.text, sessionIndex)
                    }
                }
            }
        }

        // Bottom-Right Info & Clock Area
        Column {
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.rightMargin: 60
            anchors.bottomMargin: 60
            spacing: 8

            Text {
                id: welcomeLabel
                text: username.text || "Welcome"
                color: config.clock_color
                font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                font.pixelSize: 22
                font.bold: true
                anchors.right: parent.right
                opacity: 0.8
            }

            Text {
                id: timeLabel
                text: Qt.formatTime(new Date(), "hh:mm")
                color: config.clock_color
                font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                font.pixelSize: ${DT_SPACING_SDDM_CLOCK_SIZE:-70}
                font.bold: true
                anchors.right: parent.right
            }

            Text {
                id: dateLabel
                text: Qt.formatDate(new Date(), Qt.DefaultLocaleLongDate)
                color: config.clock_color
                font.family: "${DT_TYPOGRAPHY_SDDM_FONT:-Fira Sans}"
                font.pixelSize: 16
                anchors.right: parent.right
                opacity: 0.8
            }
        }
    }

    Timer {
        interval: 1000
        running: true
        repeat: true
        onTriggered: {
            timeLabel.text = Qt.formatTime(new Date(), "hh:mm")
            dateLabel.text = Qt.formatDate(new Date(), Qt.DefaultLocaleLongDate)
        }
    }

    Connections {
        target: sddm
        function onLoginSucceeded() {}
        function onLoginFailed() {
            password.text = ""
            password.forceActiveFocus()
        }
    }
}
QML

    # Create metadata.desktop
    sudo tee "$THEME_DIR/metadata.desktop" > /dev/null <<'EOF'
[SddmGreeterTheme]
Name=Shayar
Type=sddm-theme
Description=Shayar SDDM theme with matugen color sync
License=MIT
Version=1.0.0
Theme-Id=shayar
Theme-API=2.0
MainScript=Main.qml
ConfigFile=theme.conf.user
EOF

    # Create default theme.conf
    sudo tee "$THEME_DIR/theme.conf" > /dev/null <<'EOF'
[General]
background-fill-mode = "fill"
background = "blurred.png"
clock_color = "#ffffff"
input_text_color = "#ffffff"
input_placeholder_color = "#888888"
input_bg_color = "#1f1f28"
input_bg_opacity = 0.3
input_border_color = "#43474f"
input_border_size = 1
button_text_color = "#ffffff"
button_bg_color = "#acc7ff"
button_bg_opacity = 0.9
EOF

    # Setup symlinks from theme dir to writable cache dir
    sudo rm -f "$THEME_DIR/theme.conf.user" "$BACKGROUNDS_DIR/blurred.png" "$BACKGROUNDS_DIR/avatar.png"
    sudo ln -sf "$CACHE_DIR/theme.conf.user" "$THEME_DIR/theme.conf.user"
    sudo ln -sf "$CACHE_DIR/blurred.png" "$BACKGROUNDS_DIR/blurred.png"
    sudo ln -sf "$CACHE_DIR/avatar.png" "$BACKGROUNDS_DIR/avatar.png"

    info "Theme installed at $THEME_DIR"
    info "Activate with: sudo sed -i 's/^Current=.*/Current=shayar/' /etc/sddm.conf"
    info "Or: sudo ln -sf /etc/sddm.conf.d/shayar.conf /etc/sddm.conf.d/active.conf"
}

# --- Sync ---
sync_theme() {
    check_sddm

    if [ ! -d "$THEME_DIR" ] || [ ! -d "$CACHE_DIR" ]; then
        error "Theme not installed. Run: shayar-sddm-sync --install"
        exit 1
    fi

    if [ ! -f "$SHAYAR_JSON" ]; then
        error "shayar.json not found at $SHAYAR_JSON"
        error "Run: shayar-design-tokens generate"
        exit 1
    fi

    local cache_folder="${HOME}/.cache/shayar/hyprland-dotfiles"
    local blurred_wp="$cache_folder/blurred_wallpaper.png"
    local square_wp="$cache_folder/square_wallpaper.png"
    local wallpaper=$(get_wallpaper)

    info "Syncing wallpaper and colors to SDDM cache..."

    # Copy blurred wallpaper
    if [ -f "$blurred_wp" ]; then
        cp "$blurred_wp" "$CACHE_DIR/blurred.png"
        info "Copied blurred wallpaper"
    else
        cp "$wallpaper" "$CACHE_DIR/blurred.png"
        warn "Blurred wallpaper cache not found, using raw wallpaper"
    fi

    # Copy avatar (square wallpaper)
    if [ -f "$square_wp" ]; then
        cp "$square_wp" "$CACHE_DIR/avatar.png"
        info "Copied avatar"
    else
        cp "$wallpaper" "$CACHE_DIR/avatar.png"
        warn "Square wallpaper cache not found, using raw wallpaper"
    fi

    chmod 644 "$CACHE_DIR/blurred.png" "$CACHE_DIR/avatar.png"

    # Generate theme.conf.user with matugen colors using static filename
    generate_theme_conf "blurred.png"

    info "SDDM sync complete!"
    info "Changes take effect on next login screen appearance."
}

# --- Status ---
show_status() {
    echo "=== SDDM Sync Status ==="
    echo

    # Check SDDM
    if command -v sddm &>/dev/null || command -v sddm-greeter-qt6 &>/dev/null; then
        echo "SDDM: installed"
    else
        echo "SDDM: NOT installed"
        return 1
    fi

    # Check theme
    if [ -d "$THEME_DIR" ]; then
        echo "Theme: installed at $THEME_DIR"
        if [ -f "$THEME_DIR/theme.conf.user" ]; then
            echo "theme.conf.user: exists"
            local bg=$(grep "^background = " "$THEME_DIR/theme.conf.user" | head -1 | cut -d'"' -f2)
            echo "Current background: ${bg:-unknown}"
        else
            echo "theme.conf.user: not generated (run shayar-sddm-sync)"
        fi
    else
        echo "Theme: NOT installed (run shayar-sddm-sync --install)"
    fi

    # Check active theme
    if [ -f /etc/sddm.conf ]; then
        local current=$(grep -E "^Current=" /etc/sddm.conf | cut -d= -f2)
        echo "Active theme: ${current:-unknown}"
    elif [ -d /etc/sddm.conf.d ]; then
        local current=$(grep -rn "Current=" /etc/sddm.conf.d/ 2>/dev/null | head -1 | cut -d= -f2)
        echo "Active theme: ${current:-unknown}"
    fi
}

# --- Parse args ---
case "${1:-}" in
    --install|-i) install_theme ;;
    --status|-s)  show_status ;;
    --help|-h)    usage ;;
    "")           sync_theme ;;
    *)            error "Unknown option: $1"; usage; exit 1 ;;
esac
