/*
 * Popup picker — northeast anchored, narrow width, tighter padding
 */
@import "shared-base.rasi"

configuration {
    modi:                       "drun,filebrowser,run";
    show-icons:                 true;
    display-drun:               " ";
    display-run:                " ";
    display-filebrowser:        " ";
    display-window:             " ";
    drun-display-format:        "{name}";
    hover-select:               false;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
    window-format:              "{w} · {c} · {t}";
    click-to-exit:              true;
    close-on-delete:            true;
    kb-cancel:                  "Escape,MousePrimary";
}

window {
    width:                        @dt-spacing-rofi-popup-width;
    x-offset:                     -0.5em;
    y-offset:                     0.5em;
    location:                     northeast;
    anchor:                       northeast;
}

imagebox {
    padding:                      @dt-spacing-rofi-popup-padding;
}

inputbar {
    padding:                     @dt-spacing-rofi-popup-padding;
}

listview {
    padding:                     @dt-spacing-rofi-popup-padding;
}

element {
    padding:                     1em;
    border-radius:               @dt-spacing-rofi-popup-element-radius;
}

element selected.normal {
    border-radius:               @dt-spacing-rofi-popup-selected-radius;
}
