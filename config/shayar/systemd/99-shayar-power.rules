# Shayar Power Management udev rules
# Automatically manages CPU Turbo Boost & PCIe ASPM on AC/Battery transition

# On AC Power
SUBSYSTEM=="power_supply", ATTR{online}=="1", RUN+="/bin/sh -c 'echo 1 > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null; echo default > /sys/module/pcie_aspm/parameters/policy 2>/dev/null'"

# On Battery
SUBSYSTEM=="power_supply", ATTR{online}=="0", RUN+="/bin/sh -c 'echo 0 > /sys/devices/system/cpu/cpufreq/boost 2>/dev/null; echo powersupersave > /sys/module/pcie_aspm/parameters/policy 2>/dev/null'"
