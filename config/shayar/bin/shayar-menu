#!/usr/bin/env bash
set -euo pipefail

# shayar-menu — unified settings menu

ITEM_DIR="$HOME/.config/shayar/extensions/available/menu-items"

# Build list: built-in + extension items
entries=""
add_entry() { entries="${entries}$1\n"; }

add_entry "  Settings (Nexus)|qs -c caelestia ipc call nexus open"
add_entry "  Lock|shayar-power -k"
add_entry "  Shutdown|shayar-power -p"
add_entry "  Reboot|shayar-power -r"
add_entry "  Logout|shayar-power -l"
add_entry "󰖔  Wallpaper Random|shayar-wallpaper --random"

add_entry "ﮰ  Screenshot|shayar-screenshot"
add_entry "  Network|shayar-net-toggle"
add_entry "  Bluetooth|shayar-bt-toggle"
add_entry "  System Updates|shayar-install-system-updates"
add_entry "  Status Bar Toggle|shayar-toggle-statusbar"
add_entry "  Clipboard|shayar-cliphist"
add_entry "  File Manager|shayar-apps filemanager"
add_entry "󰀻  System Monitor|shayar-apps systemmonitor"
add_entry "  Editor|shayar-apps editor"

# Extension menu items
if [ -d "$ITEM_DIR" ]; then
    for item in "$ITEM_DIR"/*; do
        [ -f "$item" ] || continue
        while IFS='|' read -r label cmd; do
            add_entry "$label|$cmd"
        done < "$item"
    done
fi

chosen=$(echo -e "$entries" | fuzzel --dmenu -p "Shayar > ")

if [ -n "$chosen" ]; then
    cmd="${chosen#*|}"
    bash -c "$cmd"
fi
