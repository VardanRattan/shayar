#!/usr/bin/env bash
set -euo pipefail

# shayar-autologin — Manage SDDM auto-login + instant lock on boot
AUTOLOGIN_FILE="/etc/sddm.conf.d/10-autologin.conf"
CURRENT_USER="${USER:-$(id -un)}"

info()  { printf "\033[1;34m:: %s\033[0m\n" "$1"; }
warn()  { printf "\033[1;33m:: %s\033[0m\n" "$1"; }
error() { printf "\033[1;31m:: %s\033[0m\n" "$1"; }

usage() {
    cat << 'HELPEOF'
shayar-autologin — Instant background desktop boot with lockscreen

Usage:
  shayar-autologin --status     Check if auto-login is currently enabled
  shayar-autologin --enable     Enable SDDM auto-login for current user
  shayar-autologin --disable    Disable auto-login (restore standard SDDM prompt)
  shayar-autologin --help       Show this help message
HELPEOF
}

check_status() {
    if [ -f "$AUTOLOGIN_FILE" ]; then
        info "Auto-login is ENABLED in $AUTOLOGIN_FILE"
        cat "$AUTOLOGIN_FILE"
    else
        info "Auto-login is DISABLED (standard SDDM login prompt active)"
    fi
}

enable_autologin() {
    info "Enabling instant background startup (SDDM auto-login -> Shayar Lock Screen)..."
    sudo mkdir -p /etc/sddm.conf.d
    echo -e "[Autologin]\nUser=$CURRENT_USER\nSession=hyprland.desktop" | sudo tee "$AUTOLOGIN_FILE" >/dev/null
    info "SDDM auto-login enabled for user '$CURRENT_USER' with Hyprland session."
    info "On next boot, the desktop will initialize in the background while locked."
}

disable_autologin() {
    if [ -f "$AUTOLOGIN_FILE" ]; then
        sudo rm -f "$AUTOLOGIN_FILE"
        info "Auto-login disabled. Standard SDDM login screen restored."
    else
        info "Auto-login was not enabled."
    fi
}

case "${1:-}" in
    --status|-s)
        check_status
        ;;
    --enable|-e)
        enable_autologin
        ;;
    --disable|-d)
        disable_autologin
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        error "Unknown argument: $1"
        usage
        exit 1
        ;;
esac
