pkgname=shayar-dotfiles-git
pkgver=1.0.0
pkgrel=1
pkgdesc="A unified Hyprland desktop shell and Material You design system"
arch=('any')
url="https://github.com/VardanRattan/shayar"
license=('GPL3')
depends=('hyprland' 'caelestia-shell' 'caelestia-cli' 'kitty' 'fuzzel' 'jq' 'matugen' 'awww-daemon')
makedepends=('git')
provides=('shayar-dotfiles')
conflicts=('shayar-dotfiles')
source=("git+https://github.com/VardanRattan/shayar.git")
md5sums=('SKIP')

pkgver() {
  cd "$srcdir/shayar"
  printf "%s.r%s.%s" "$(git describe --tags --abbrev=0 2>/dev/null || echo 1.0.0)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd "$srcdir/shayar"
  
  # Install dotfiles to /usr/share/shayar
  install -d "$pkgdir/usr/share/shayar"
  cp -a . "$pkgdir/usr/share/shayar/"
  
  # Provide an executable to bootstrap the dotfiles in user home
  install -d "$pkgdir/usr/bin"
  cat << 'EOF' > "$pkgdir/usr/bin/shayar-install"
#!/usr/bin/env bash
set -euo pipefail
echo "Installing Shayar to ~/.config/shayar..."
mkdir -p ~/.config
cp -r /usr/share/shayar ~/.config/shayar
cd ~/.config/shayar
./scripts/link.sh
echo "Shayar installed successfully!"
EOF
  chmod +x "$pkgdir/usr/bin/shayar-install"
}
