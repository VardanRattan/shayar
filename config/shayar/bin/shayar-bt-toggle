#!/usr/bin/env bash
set -euo pipefail
QS_SHELL="${HOME}/.config/quickshell/shell.qml"

ensure_qs() {
    if pgrep -x qs > /dev/null 2>&1; then
        return 0
    fi
    (
        flock -x 200
        if ! pgrep -x qs > /dev/null 2>&1; then
            qs -p "$QS_SHELL" &
        fi
        local retries=20
        while ! pgrep -x qs > /dev/null 2>&1; do
            sleep 0.1
            retries=$((retries - 1))
            [ "$retries" -le 0 ] && { echo "Warning: quickshell failed to start" >&2; return 1; }
        done
    ) 200>"/tmp/shayar-qs.lock"
}
ensure_qs

qs -p "$QS_SHELL" ipc call power close
qs -p "$QS_SHELL" ipc call calendar close
qs -p "$QS_SHELL" ipc call net close
qs -p "$QS_SHELL" ipc call bt toggle
